// C++ code
//
int contador = 0;

void setup()
{
 
  pinMode(8, OUTPUT);
  pinMode(9, OUTPUT);
  pinMode(7, INPUT);
  pinMode(5, OUTPUT);
}

void loop()
{
  digitalWrite(1, HIGH);
  digitalWrite(2, LOW);
  digitalWrite(3, LOW);
  digitalWrite(5, LOW);
  digitalWrite(8, HIGH);
  digitalWrite(9, LOW);
  contador = 0;
  while (contador < 50) {
    if (digitalRead(7) == LOW) {
      contador = 50;
    } else {
      delay(100); // Wait for 100 millisecond(s)
      contador += 1;
    }
  }
  digitalWrite(1, LOW);
  digitalWrite(2, HIGH);
  digitalWrite(3, LOW);
  delay(2000); // Wait for 2000 millisecond(s)
  digitalWrite(1, LOW);
  digitalWrite(2, LOW);
  digitalWrite(3, HIGH);
  digitalWrite(5, HIGH);
  digitalWrite(8, LOW);
  digitalWrite(9, HIGH);
  delay(4000); // Wait for 4000 millisecond(s)
  digitalWrite(5, LOW);
}
